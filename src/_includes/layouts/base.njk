<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% if title %}{{ title }} — {{ site.short_name }}{% else %}{{ site.name }}{% endif %}</title>
<meta name="description" content="{{ description or site.description }}">
{% if site.favicon %}<link rel="icon" href="{{ site.favicon }}" type="image/png">{% endif %}
<link rel="stylesheet" href="/css/site.css">
<link rel="alternate" type="application/rss+xml" title="{{ site.name }} news" href="/feed.xml">
</head>
<body>
<a class="skip-link" href="#main">Skip to content</a>
{% include "partials/header.njk" %}
<main id="main" class="main">
{{ content | safe }}
</main>
{% include "partials/footer.njk" %}
<script src="/js/nav.js" defer></script>
</body>
</html>
