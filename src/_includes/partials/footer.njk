<footer class="site-footer">
  <div class="wrap site-footer__inner">
    <div class="site-footer__affiliations">
      {% for a in site.affiliations %}
      <a href="{{ a.url }}" class="site-footer__affiliation">
        {% if a.logo %}<img src="{{ a.logo }}" alt="{{ a.name }}" height="44" loading="lazy">
        {% else %}{{ a.name }}{% endif %}
      </a>
      {% endfor %}
    </div>
    <div class="site-footer__meta">
      <p class="site-footer__copyright">{{ site.footer.copyright }}</p>
      {% if site.footer.links %}
      <ul class="site-footer__links">
        {% for l in site.footer.links %}<li><a href="{{ l.url }}">{{ l.label }}</a></li>{% endfor %}
      </ul>
      {% endif %}
    </div>
  </div>
</footer>
