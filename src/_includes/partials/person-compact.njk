{# Expects `person`. Used for the alumni columns. #}
{% set d = person.data %}
<li class="person-compact" id="{{ d.slug }}">
  <span class="person-compact__name">{{ d.name }}</span>
  {% if d.degree %}<span class="person-compact__degree">{{ d.degree }}</span>{% endif %}
  <span class="person-compact__links">
    {% if d.email %}<a href="mailto:{{ d.email }}">email</a>{% endif %}
    {% if d.website %}<a href="{{ d.website }}">website</a>{% endif %}
  </span>
</li>
