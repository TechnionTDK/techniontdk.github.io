---
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- set pages = collections.all %}
{%- for item in pages %}{% if item.url and not item.url.endsWith(".xml") and item.url != "/404.html" %}
  <url>
    <loc>{{ item.url | absoluteUrl(site.url) | escape }}</loc>
    {%- if item.data.date %}
    <lastmod>{{ item.data.date | isoDate }}</lastmod>
    {%- elif item.data.updated %}
    <lastmod>{{ item.data.updated | isoDate }}</lastmod>
    {%- endif %}
  </url>
{%- endif %}{% endfor %}
</urlset>
