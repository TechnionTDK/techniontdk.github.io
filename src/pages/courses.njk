---
title: Courses
---
<div class="wrap wrap--prose">
  <h1>Courses</h1>
  <p class="lede">{{ site.courses_intro }}</p>

  <h2 class="courses__heading">Courses given in the current semester ({{ site.course_semesters[0] }})</h2>
  {% set showSemester = false %}
  {% if collections.courseRunsCurrent.length %}
  <ul class="courses">
    {% for run in collections.courseRunsCurrent %}{% include "partials/course-run.njk" %}{% endfor %}
  </ul>
  {% else %}
  <p class="courses__empty">No lab course is running this semester.</p>
  {% endif %}

  <h2 class="courses__heading">Courses given in previous semesters ({{ site.course_semesters.slice(1) | join(", ") }})</h2>
  {% set showSemester = true %}
  {% if collections.courseRunsPrevious.length %}
  <ul class="courses">
    {% for run in collections.courseRunsPrevious %}{% include "partials/course-run.njk" %}{% endfor %}
  </ul>
  {% else %}
  <p class="courses__empty">Nothing in these semesters.</p>
  {% endif %}
</div>
