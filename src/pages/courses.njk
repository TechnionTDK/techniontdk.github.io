---
title: Courses
---
<div class="wrap wrap--prose">
  <h1>Courses</h1>
  <p class="lede">{{ site.courses_intro }}</p>

  <ul class="courses">
    {% for course in collections.courses %}
    <li class="course">
      <h2 class="course__title">
        {% if course.data.url %}<a href="{{ course.data.url }}" target="_blank" rel="noopener">{{ course.data.title }}</a>
        {%- else %}{{ course.data.title }}{% endif %}
        {%- if course.data.number %} <span class="course__number">{{ course.data.number }}</span>{% endif %}
      </h2>
      {% if course.data.instructors %}
      <p class="course__instructors">
        {%- for slug in course.data.instructors %}{% set p = slug | personBySlug %}
          {%- if p %}{% if p.data.honorific %}{{ p.data.honorific }} {% endif %}{{ p.data.name }}
          {%- else %}{{ slug }}{% endif -%}
          {%- if not loop.last %}, {% endif -%}
        {% endfor -%}
      </p>
      {% endif %}
      {% if course.templateContent %}<div class="course__body prose">{{ course.templateContent | safe }}</div>{% endif %}
    </li>
    {% endfor %}
  </ul>
</div>
